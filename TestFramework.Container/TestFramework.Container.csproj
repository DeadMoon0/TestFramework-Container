<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsTestProject>false</IsTestProject>
		<Title>TestFramework.Container</Title>
		<Version>0.5.0</Version>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<Description>Shared Docker building blocks for TestFramework container environments: declaring where an application comes from and building it, network creation, host and network endpoint addressing, readiness waits and container log capture.</Description>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Container</PackageProjectUrl>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Container.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Timeline;Docker</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0; ContainerRuntime.EnsureInitialized is EnsureReadyAsync, ContainerStartup.BringUpAsync and ContainerStartCoordinator.StartAllAsync take the logger they report a failed removal to, and optional parameters became overloads. A built image is reused only while its project's sources are unchanged, and readiness waits end with the step's deadline.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Container.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
		<!-- Direct reference overrides the vulnerable SSH.NET 2025.1.0 that Testcontainers pulls in
		     transitively (GHSA-q939-rpr3-3284). Testcontainers still pins it as of 4.13.0. -->
		<PackageReference Include="SSH.NET" Version="2026.0.0" />
		<PackageReference Include="Testcontainers" Version="4.11.0" />
		<PackageReference Include="Testcontainers.MsSql" Version="4.11.0" />
		<PackageReference Include="TestFramework.Core" Version="0.7.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(PackageIconSourcePath)">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!-- Direct references override the System.Security.Cryptography.Pkcs that Microsoft.Data.SqlClient pulls
	     in transitively (8.0.1 / 9.0.4: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). One per framework, each the
	     patched release of the line that framework's runtime ships. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

</Project>
