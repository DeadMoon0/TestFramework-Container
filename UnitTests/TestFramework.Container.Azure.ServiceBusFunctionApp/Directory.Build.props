<Project>

	<!-- MSBuild stops at the nearest Directory.Build.props, so the repository-wide one is imported by
	     hand. Without this line the conventions above would not reach this project. -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

	<PropertyGroup>
		<!-- The Functions worker SDK builds a nested WorkerExtensions project under obj, and the
		     ServiceBus extension drags a runtimes\win\lib\netstandard2.0 tree several levels below that
		     again. Without this redirect the build fails with MSB3030 on a 279-character path, against
		     a Windows limit of 260; the file is never created, so the message names a copy rather than
		     a length. Redirected, the deepest file is 236 and there are 24 characters in hand.

		     The sibling HTTP fixture needs no redirect because its extension set never produces that
		     tree - it stops at 250, with ten to spare. Ten is not comfort, so if a package added there
		     ever pushes it over, redirect it the same way rather than shortening a name.

		     The target stays inside the repository. It used to be ..\..\..\artifacts, one level above
		     the clone, where a standalone checkout writes 30 MB into whatever directory happens to sit
		     there.

		     Sharing one path between builds costs nothing. Two concurrent builds of a single project
		     collide on its obj whether it is redirected or not - the HTTP fixture next door fails the
		     same way, with no redirect at all - and ContainerImageBuilder already gates a project's
		     builds against each other, in process and machine-wide. -->
		<BaseIntermediateOutputPath>..\..\artifacts\sbfa-obj\</BaseIntermediateOutputPath>
		<MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
	</PropertyGroup>

</Project>
