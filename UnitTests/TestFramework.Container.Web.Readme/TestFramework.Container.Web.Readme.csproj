<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# samples of TestFramework.Container.Web/README.md, compiled and never run. Each README block is a
       #region snippet:name here; ReadmeSnippetTests holds the two to the same text. Not a test project, so a
       sample that names an application or a frontend nobody ships is checked for compiling and not started. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TestFramework.Container.Web\TestFramework.Container.Web.csproj" />
  </ItemGroup>

</Project>
