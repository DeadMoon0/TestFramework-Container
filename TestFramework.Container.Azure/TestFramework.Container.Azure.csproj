<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<IsTestProject>false</IsTestProject>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>TestFramework.Container.Azure</Title>
		<Version>0.6.0</Version>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<Description>Docker-backed environment providers for TestFramework timelines for Azure components.</Description>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Container</PackageProjectUrl>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Container.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Timeline;Docker;Azure</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0, TestFramework.Config 0.4.0 and TestFramework.Azure 0.5.0; ConfigureDockerAzureCosmosEmulator() is AddDockerAzure(), and a Service Bus topology must be described with ConfigureServiceBusTopology or the run is refused while it is planned. BREAKING - renamed as in TestFramework.Azure: UseStorageAccount, UseCosmosDb, DockerStorageAccountDefinition, DockerCosmosDbDefinition, DockerSqlDatabaseDefinition, FunctionAppStorageAccountBinding, FunctionAppCosmosDbBinding, the Used*Identifiers lists, and the overrides QueueName, TableName and RequiresSession; the Use* bindings take a binding record instead of optional names. DockerAzureEnvironment hands each run its own instance, so read the used identifiers from run.Environment after a run.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Container.Azure.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<!-- Container is consumed as a published package, not as a project, so the dependency this
		     package declares is exactly the one a consumer resolves. Container must be published
		     before this package ships against it. -->
		<PackageReference Include="TestFramework.Container" Version="0.5.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(PackageIconSourcePath)">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
		<!-- Tables and queues arrive transitively through TestFramework.Azure, but the per-run reset
		     compiles against both, so they are named here rather than depended on by accident. -->
		<PackageReference Include="Azure.Data.Tables" Version="12.9.1" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
		<PackageReference Include="Azure.Storage.Queues" Version="12.26.0" />
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.59.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<!-- Direct reference overrides the vulnerable SSH.NET 2025.1.0 that Testcontainers pulls in
		     transitively (GHSA-q939-rpr3-3284). Testcontainers still pins it as of 4.13.0. -->
		<PackageReference Include="SSH.NET" Version="2026.0.0" />
		<PackageReference Include="Testcontainers" Version="4.11.0" />
		<PackageReference Include="Testcontainers.Azurite" Version="4.11.0" />
		<PackageReference Include="Testcontainers.CosmosDb" Version="4.11.0" />
		<PackageReference Include="Testcontainers.MsSql" Version="4.11.0" />
		<PackageReference Include="Testcontainers.ServiceBus" Version="4.11.0" />
		<PackageReference Include="TestFramework.Azure" Version="0.5.0" />
		<PackageReference Include="TestFramework.Config" Version="0.4.0" />
		<PackageReference Include="TestFramework.Core" Version="0.7.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!-- Direct references override the System.Security.Cryptography.Pkcs that Microsoft.Data.SqlClient pulls
	     in transitively (8.0.1 / 9.0.4: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). One per framework, each the
	     patched release of the line that framework's runtime ships. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

</Project>
