<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<IsTestProject>false</IsTestProject>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- This project's public surface is largely undocumented, and TreatWarningsAsErrors would turn
		     every missing comment into a build failure. Removing this line is the forcing function for
		     the documentation pass; it is a bridge, not a decision. -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Title>TestFramework.Container.Azure</Title>
		<Version>0.6.0</Version>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<Description>Docker-backed environment providers for TestFramework timelines for Azure components.</Description>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Container</PackageProjectUrl>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Container.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Timeline;Docker;Azure</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0, TestFramework.Config 0.4.0 and TestFramework.Azure 0.5.0. UseStorage, UseCosmos, UseServiceBusTrigger and UseServiceBusReply take a binding record (FunctionAppStorageBinding and so on) instead of optional setting names; the four contracts take init properties; other optional parameters became overloads. DockerAzureEnvironment is sealed and hands each run its own instance, so after a run read UsedStorageIdentifiers and the rest from run.Environment; the one passed to SetEnv stays empty. A Service Bus topology is no longer defaulted to a file this package never shipped: describe one with ConfigureServiceBusTopology, or the run is refused while it is planned. DockerSqlDefinition is renamed DockerAzureSqlDefinition, so Container.Azure and Container.Web can be imported together.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Container.Azure.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<!-- Container is consumed as a published package, not as a project, so the dependency this
		     package declares is exactly the one a consumer resolves. Container must be published
		     before this package ships against it. -->
		<PackageReference Include="TestFramework.Container" Version="0.5.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Modules\TestFramework-Common\Assets\Icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
		<!-- Tables and queues arrive transitively through TestFramework.Azure, but the per-run reset
		     compiles against both, so they are named here rather than depended on by accident. -->
		<PackageReference Include="Azure.Data.Tables" Version="12.9.1" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
		<PackageReference Include="Azure.Storage.Queues" Version="12.26.0" />
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.59.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<!-- Direct reference overrides the vulnerable SSH.NET 2025.1.0 that Testcontainers pulls in
		     transitively (GHSA-q939-rpr3-3284). Testcontainers still pins it as of 4.13.0. -->
		<PackageReference Include="SSH.NET" Version="2026.0.0" />
		<PackageReference Include="Testcontainers" Version="4.11.0" />
		<PackageReference Include="Testcontainers.Azurite" Version="4.11.0" />
		<PackageReference Include="Testcontainers.CosmosDb" Version="4.11.0" />
		<PackageReference Include="Testcontainers.MsSql" Version="4.11.0" />
		<PackageReference Include="Testcontainers.ServiceBus" Version="4.11.0" />
		<PackageReference Include="TestFramework.Azure" Version="0.5.0" />
		<PackageReference Include="TestFramework.Config" Version="0.4.0" />
		<PackageReference Include="TestFramework.Core" Version="0.7.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!-- Direct references override the System.Security.Cryptography.Pkcs that Microsoft.Data.SqlClient 6.1.2 pulls
	     in transitively (8.0.1 / 9.0.4: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). One per framework, each the
	     patched release of the line that framework's runtime ships. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

</Project>
