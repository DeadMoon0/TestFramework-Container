<Project>

	<!--
	  One place for the settings every project in this repository shares.

	  They were repeated in each csproj, and TreatWarningsAsErrors was repeated twice more per project
	  behind 'Debug|AnyCPU' and 'Release|AnyCPU' conditions - which meant it silently did not apply to
	  any other configuration or platform. Here it applies to all of them.
	-->
	<PropertyGroup>
		<!-- Every using is written where it is needed, so a file says what it depends on. -->
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<!-- Packaging and source-debugging conventions. A .snupkg carries the SourceLink data that
	     lets a consumer step into this code, and that the generated API documentation links from. -->
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>


  <!-- The package icon comes from the TestFramework-Common submodule. A clone without it would otherwise fail
       to pack with NuGet's opaque "icon not found"; this names the cause and the command that fixes it. -->
  <PropertyGroup>
    <PackageIconSourcePath>$(MSBuildThisFileDirectory)Modules\TestFramework-Common\Assets\Icon.png</PackageIconSourcePath>
  </PropertyGroup>

  <Target Name="EnsurePackageIconSubmoduleIsInitialized" BeforeTargets="GenerateNuspec" Condition="'$(PackageIcon)' != ''">
    <Error Condition="!Exists('$(PackageIconSourcePath)')"
           Text="The package icon &quot;$(PackageIconSourcePath)&quot; is missing because the TestFramework-Common submodule is not checked out. Run 'git submodule update --init --recursive' in the repository root and pack again." />
  </Target>

</Project>
